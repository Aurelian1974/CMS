<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Fiscal bridge: serviciu Windows pe PC-ul de la recepție, la care e conectată casa de marcat.
    Ascultă DOAR pe 127.0.0.1 — browserul de pe același PC îi trimite bonurile de tipărit.
    Nu referă proiectele aplicației: comunică cu ele doar prin contractul HTTP.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ValyanClinic.FiscalBridge</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.*" />
    <PackageReference Include="System.IO.Ports" Version="10.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ValyanClinic.FiscalBridge.Tests" />
  </ItemGroup>

</Project>
