{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "Bridge": {
    "Port": 5199,
    "AllowedOrigins": [ "http://localhost:5173" ],
    "DataDirectory": ""
  },
  "Printer": {
    "Driver": "Mock",
    "MockScenario": "None",
    "Transport": "Serial",
    "PortName": "COM3",
    "BaudRate": 115200,
    "Host": "",
    "TcpPort": 4999,
    "OperatorCode": "1",
    "TillNumber": "1",
    "ResponseTimeoutMs": 1000,
    "BusyTimeoutMs": 15000,
    "MaxNakRetries": 3,
    "TextEncoding": "windows-1250",
    "MaxItemNameLength": 36
  }
}
